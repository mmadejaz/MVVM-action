<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MVVM_action.Views.PersonView"
             Title="PersonView">
    <VerticalStackLayout>
        <Entry
            Placeholder="Imię"
            Text="{Binding FirstName}"/>
        <Entry
            Placeholder="Nazwisko"
            Text="{Binding LastName}"/>
        <Label
            FontSize="24"
            Text="{Binding FirstName}"/>
        <Label
            FontSize="24"
            Text="{Binding LastName}"/>
        <Button
            Text="Zmień dane"
            Command="{Binding ChangeNameCommand}"/>
        <Button
            Text="Usuń dane"
            Command="{Binding ResetNameCommand}"/>
        <Button
            Text="Losuj dane"
            Command="{Binding RandomNameCommand}"/>
    </VerticalStackLayout>
</ContentPage>